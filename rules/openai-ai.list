# OpenAI destination rules, inlined at the start of the main INI after LAN.
# Reviewed 2026-10-16. Core suffixes cover ChatGPT, Codex, API, auth, files,
# updates, documentation, status and WebSockets without whole-process rules.
# Official dependency list:
# https://help.openai.com/en/articles/9247338-network-recommendations-for-chatgpt-errors-on-web-and-apps
DOMAIN-SUFFIX,openai.com
DOMAIN-SUFFIX,chatgpt.com
DOMAIN-SUFFIX,chat.com
DOMAIN-SUFFIX,sora.com
DOMAIN-SUFFIX,oaistatic.com
DOMAIN-SUFFIX,oaiusercontent.com
DOMAIN-SUFFIX,oaistatsig.com
DOMAIN-SUFFIX,openaimerge.com

# Officially documented shared dependencies. These hosts also serve other sites;
# destination rules necessarily route those requests through AI as well.
DOMAIN-SUFFIX,ct.sendgrid.net
DOMAIN-SUFFIX,intercom.io
DOMAIN-SUFFIX,intercomcdn.com
DOMAIN,cdn.workos.com
DOMAIN,forwarder.workos.com
DOMAIN,frontend-apps-multi-region.workos.com
DOMAIN,setup.workos.com
DOMAIN,images.workoscdn.com
DOMAIN,workos.imgix.net
DOMAIN,challenges.cloudflare.com
DOMAIN,humb.apple.com
DOMAIN,js.stripe.com
DOMAIN,o207216.ingest.sentry.io
DOMAIN,o33249.ingest.sentry.io
DOMAIN,rum.browser-intake-datadoghq.com

# Additional known OpenAI CDN, challenge, feature and voice destinations.
# Supplementary source (not a blanket import of its shared SaaS or cloud ASNs):
# https://github.com/VPSDance/ai-proxy-rules/blob/main/rules/quantumult-x/global.list
DOMAIN-SUFFIX,openai.com.cdn.cloudflare.net
DOMAIN-SUFFIX,openaiapi-site.azureedge.net
DOMAIN,openaicom.imgix.net
DOMAIN,openai-api.arkoselabs.com
DOMAIN,openaiassets.blob.core.windows.net
DOMAIN,openaicom-api-bdcpf8c6d2e9atf6.z01.azurefd.net
DOMAIN,openaicomproductionae4b.blob.core.windows.net
DOMAIN,production-openaicom-storage.azureedge.net
DOMAIN-SUFFIX,chatgpt.livekit.cloud
DOMAIN-SUFFIX,host.livekit.cloud
DOMAIN-SUFFIX,turn.livekit.cloud
DOMAIN-SUFFIX,api.statsig.com
DOMAIN-SUFFIX,events.statsigapi.net
DOMAIN-SUFFIX,featuregates.org
DOMAIN-SUFFIX,client-api.arkoselabs.com

# ChatGPT Voice literal-IP traffic (UDP 3478, TCP 443 fallback).
# https://openai.com/chatgpt-voice.json
# creationTime: 2026-03-26T20:12:45.451356+00:00; retrieved 2026-10-16.
# no-resolve prevents these rules from forcing DNS resolution for other traffic.
# Refresh against the official JSON when --online reports missing voice ranges.
